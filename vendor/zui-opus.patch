+pub struct AtlasHandle(Arc<dyn PlatformAtlas>);
+
+impl AtlasHandle {
+    fn key(data: &RenderImage, frame_index: usize) -> crate::AtlasKey {
+        RenderImageParams {
+            image_id: data.id,
+            frame_index,
