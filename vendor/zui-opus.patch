+/// A GPU context and the window's surface on it: Vulkan when it has a GPU
+/// that can draw to the window, else GL (which isn't even probed otherwise;
+/// see [`WgpuContext::instance`]).
+#[cfg(not(target_family = "wasm"))]
+fn create_context<W>(
+    window: &W,
+    raw_window_handle: raw_window_handle::RawWindowHandle,
+    compositor_gpu: Option<CompositorGpuHint>,
+    reject_software: bool,
+) -> anyhow::Result<(WgpuContext, wgpu::Surface<'static>)>
+where
+    W: HasWindowHandle + HasDisplayHandle + std::fmt::Debug + Send + Sync + Clone + 'static,
+{
+    let mut failure = None;
+    for backends in [wgpu::Backends::VULKAN, wgpu::Backends::GL] {
+        let instance = WgpuContext::instance(Box::new(window.clone()), backends);
+        let attempt = create_surface(&instance, raw_window_handle).and_then(|surface| {
+            let context = WgpuContext::new_with_options(instance, &surface, compositor_gpu, reject_software)?;
+            Ok((context, surface))
+        });
+        match attempt {
+            Ok(found) => return Ok(found),
+            Err(error) => {
+                log::info!("no usable {backends:?} GPU: {error:#}");
+                failure = Some(error);
+            }
+        }
+    }
+    Err(failure.expect("tried at least one backend"))
+}
