+    /// The corner radius to clip children to, as CSS's `overflow: hidden`
+    /// clips to `border-radius`: for an element hiding overflow on both axes
+    /// with one radius on all four corners (inside its border). `None`
+    /// means a rectangular clip suffices.
+    pub fn overflow_clip_radius(&self, bounds: Bounds<Pixels>, rem_size: Pixels) -> Option<Pixels> {
+        if self.overflow.x == Overflow::Visible || self.overflow.y == Overflow::Visible {
+            return None;
+        }
+        let r = self.corner_radii.map(|r| r.to_pixels(rem_size));
+        if r.top_left != r.top_right || r.top_left != r.bottom_left || r.top_left != r.bottom_right {
+            return None;
+        }
+        let border = if self.border_color.is_some_and(|color| !color.is_transparent()) {
+            let w = &self.border_widths;
+            [w.left, w.right, w.top, w.bottom].iter().map(|w| w.to_pixels(rem_size)).fold(Pixels::ZERO, |a, b| a.max(b))
+        } else {
+            Pixels::ZERO
+        };
+        let half = bounds.size.width.min(bounds.size.height) / 2.0;
+        let radius = (r.top_left.min(half) - border).max(Pixels::ZERO);
+        (radius > Pixels::ZERO).then_some(radius)
+    }
