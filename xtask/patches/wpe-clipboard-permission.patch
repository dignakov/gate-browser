+void WebKitWebViewClient::requestDOMPasteAccess(WKWPE::View&, CompletionHandler<void(WebCore::DOMPasteAccessResponse)>&& completionHandler)
+{
+    auto request = adoptGRef(webkitClipboardPermissionRequestCreate(WTF::move(completionHandler)));
+    webkitWebViewMakePermissionRequest(m_webView, WEBKIT_PERMISSION_REQUEST(request.get()));
+}
