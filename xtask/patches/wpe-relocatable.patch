+#include "config.h"
+#include "InstallPrefix.h"
+
+#include <dlfcn.h>
+#include <limits.h>
+#include <mutex>
+#include <stdlib.h>
+#include <string.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/glib/GUniquePtr.h>
+
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+
+namespace WTF {
+
+static constexpr size_t builtPrefixLength = sizeof(WEBKIT_INSTALL_PREFIX) - 1;
+
+// Where the install prefix is now: the directory holding the library this
+// code is in, less the library directory's place under the prefix.
+static const CString& installPrefix()
+{
+    static LazyNeverDestroyed<CString> prefix;
+    static std::once_flag onceFlag;
+    std::call_once(onceFlag, [] {
+        prefix.construct(WEBKIT_INSTALL_PREFIX);
+        const char* libraryDirectory = WEBKIT_LIB_INSTALL_DIR;
+        if (strncmp(libraryDirectory, WEBKIT_INSTALL_PREFIX, builtPrefixLength))
+            return;
+        const char* libraryUnderPrefix = libraryDirectory + builtPrefixLength;
+
+        Dl_info info;
+        if (!dladdr(reinterpret_cast<void*>(&installPrefix), &info) || !info.dli_fname)
+            return;
+        char* library = realpath(info.dli_fname, nullptr);
+        if (!library)
+            return;
+        GUniquePtr<char> directory(g_path_get_dirname(library));
+        free(library);
+        size_t length = strlen(directory.get());
+        size_t underLength = strlen(libraryUnderPrefix);
+        if (length < underLength || strcmp(directory.get() + length - underLength, libraryUnderPrefix))
+            return;
+        prefix.get() = CString(std::span<const char>(directory.get(), length - underLength));
+    });
+    return prefix.get();
+}
+
+CString relocatedInstallPath(const char* path)
+{
+    if (strncmp(path, WEBKIT_INSTALL_PREFIX, builtPrefixLength) || (path[builtPrefixLength] && path[builtPrefixLength] != '/'))
+        return path;
+    GUniquePtr<char> relocated(g_strconcat(installPrefix().data(), path + builtPrefixLength, nullptr));
+    return relocated.get();
+}
+
+} // namespace WTF
+
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
